{
  "name": "ghost-shell",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency retro-futuristic CRT browser terminal emulator with procedural Web Audio synthesis and HTML5 Canvas shaders.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
